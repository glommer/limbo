+    /// Compile aggregates with DISTINCT by chaining two aggregate operators
+    fn compile_distinct_aggregates(
+        &mut self,
+        agg: &crate::translate::logical::Aggregate,
+        input_id: i64,
+    ) -> Result<i64> {
+        use crate::function::AggFunc;
+        use crate::incremental::aggregate_operator::AggregateFunction;
+
+        let input_schema = agg.input.schema();
+        let input_column_names: Vec<String> = input_schema
+            .columns
+            .iter()
+            .map(|col| col.name.clone())
+            .collect();
+
+        // Build group by column indices
+        let mut group_by_indices = Vec::new();
+        for expr in &agg.group_expr {
+            if let LogicalExpr::Column(col) = expr {
+                let (col_idx, _) = input_schema
+                    .find_column(&col.name, col.table.as_deref())
+                    .ok_or_else(|| {
+                        LimboError::ParseError(format!(
+                            "GROUP BY column '{}' not found in input",
+                            col.name
+                        ))
+                    })?;
+                group_by_indices.push(col_idx);
+            } else {
+                return Err(LimboError::ParseError(
+                    "Only column references are supported in GROUP BY for DISTINCT aggregates"
+                        .to_string(),
+                ));
+            }
+        }
+
+        // Collect information about DISTINCT aggregates
+        let mut distinct_col_idx = None;
+        let mut distinct_agg_func = None;
+        let mut non_distinct_count = 0;
+
+        for expr in &agg.aggr_expr {
+            if let LogicalExpr::AggregateFunction {
+                fun,
+                args,
+                distinct,
+            } = expr
+            {
+                if *distinct {
+                    if distinct_col_idx.is_some() {
+                        return Err(LimboError::ParseError(
+                            "Multiple DISTINCT aggregates are not yet supported".to_string(),
+                        ));
+                    }
+
+                    // Store the aggregate function type
+                    distinct_agg_func = Some(fun.clone());
+
+                    // For COUNT, we might not have args (COUNT(*) case)
+                    // For other aggregates, we need exactly one column argument
+                    if matches!(fun, AggFunc::Count | AggFunc::Count0) {
+                        if let Some(arg) = args.first() {
+                            if let LogicalExpr::Column(col) = arg {
+                                let (col_idx, _) = input_schema
+                                    .find_column(&col.name, col.table.as_deref())
+                                    .ok_or_else(|| {
+                                        LimboError::ParseError(format!(
+                                            "DISTINCT column '{}' not found in input",
+                                            col.name
+                                        ))
+                                    })?;
+                                distinct_col_idx = Some(col_idx);
+                            } else {
+                                return Err(LimboError::ParseError(
+                                    "Only column references are supported in COUNT(DISTINCT)"
+                                        .to_string(),
+                                ));
+                            }
+                        } else {
+                            return Err(LimboError::ParseError(
+                                "COUNT(DISTINCT) requires a column argument".to_string(),
+                            ));
+                        }
+                    } else {
+                        // SUM, AVG, MIN, MAX require a column argument
+                        if args.is_empty() {
+                            return Err(LimboError::ParseError(format!(
+                                "{fun:?}(DISTINCT) requires a column argument"
+                            )));
+                        }
+                        if let LogicalExpr::Column(col) = &args[0] {
+                            let (col_idx, _) = input_schema
+                                .find_column(&col.name, col.table.as_deref())
+                                .ok_or_else(|| {
+                                    LimboError::ParseError(format!(
+                                        "DISTINCT column '{}' not found in input",
+                                        col.name
+                                    ))
+                                })?;
+                            distinct_col_idx = Some(col_idx);
+                        } else {
+                            return Err(LimboError::ParseError(format!(
+                                "Only column references are supported in {fun:?}(DISTINCT)"
+                            )));
+                        }
+                    }
+                } else {
+                    non_distinct_count += 1;
+                }
+            }
+        }
+
+        if non_distinct_count > 0 {
+            return Err(LimboError::ParseError(
+                "Cannot mix DISTINCT and non-DISTINCT aggregates yet".to_string(),
+            ));
+        }
+
+        let distinct_col_idx = distinct_col_idx.ok_or_else(|| {
+            LimboError::InternalError("Expected at least one DISTINCT aggregate".to_string())
+        })?;
+
+        // Filter out NULLs from the DISTINCT column before aggregation
+        // This is required by SQL standard - COUNT(DISTINCT col) should ignore NULLs
+        use crate::incremental::filter_operator::{FilterOperator, FilterPredicate};
+
+        let filter_predicate = FilterPredicate::IsNotNull {
+            column_idx: distinct_col_idx,
+        };
+
+        let filter_executable: Box<dyn IncrementalOperator> =
+            Box::new(FilterOperator::new(filter_predicate.clone()));
+
+        // Create IS NOT NULL expression for DBSP
+        use crate::translate::logical::Column;
+        let is_not_null_expr = LogicalExpr::IsNull {
+            expr: Box::new(LogicalExpr::Column(Column {
+                name: input_column_names[distinct_col_idx].clone(),
+                table: None,
+            })),
+            negated: true,
+        };
+        let dbsp_filter_expr = Self::compile_expr(&is_not_null_expr)?;
+
+        // Create filter node that removes NULLs from the distinct column
+        let filtered_id = self.circuit.add_node(
+            DbspOperator::Filter {
+                predicate: dbsp_filter_expr,
+            },
+            vec![input_id],
+            filter_executable,
+        );
+
+        // Stage 1: GROUP BY (original_groups + distinct_column) with DISTINCT aggregate
+        // This produces unique combinations of (group_cols, distinct_col)
+        let mut stage1_group_by = group_by_indices.clone();
+        stage1_group_by.push(distinct_col_idx);
+
+        let stage1_operator_id = self.circuit.next_id;
+        let stage1_executable: Box<dyn IncrementalOperator> = Box::new(AggregateOperator::new(
+            stage1_operator_id,
+            stage1_group_by.clone(),
+            vec![AggregateFunction::Distinct], // Use DISTINCT aggregate for existence tracking
+            input_column_names.clone(),
+        ));
+
+        // Create schema for stage 1 output (group columns + distinct column)
+        let mut stage1_columns = Vec::new();
+        for &idx in &stage1_group_by {
+            stage1_columns.push(input_schema.columns[idx].clone());
+        }
+        let stage1_schema = Arc::new(LogicalSchema::new(stage1_columns));
+
+        // Convert indices to DbspExpr for stage1
+        let stage1_group_exprs: Vec<DbspExpr> = stage1_group_by
+            .iter()
+            .map(|&idx| DbspExpr::Column(input_column_names[idx].clone()))
+            .collect();
+
+        let stage1_id = self.circuit.add_node(
+            DbspOperator::Aggregate {
+                group_exprs: stage1_group_exprs,
+                aggr_exprs: vec![AggregateFunction::Distinct],
+                schema: stage1_schema.clone(),
+            },
+            vec![filtered_id], // Use filtered input that has NULLs removed
+            stage1_executable,
+        );
+
+        // Stage 2: GROUP BY original_groups with the appropriate aggregate function
+        let stage2_operator_id = self.circuit.next_id;
+        let stage2_column_names: Vec<String> = stage1_schema
+            .columns
+            .iter()
+            .map(|col| col.name.clone())
+            .collect();
+
+        // In stage2, we need to use indices into the stage1 output schema
+        // The stage1 output has group columns first, so indices are 0..n_groups
+        let stage2_group_indices: Vec<usize> = (0..group_by_indices.len()).collect();
+
+        // Determine which aggregate function to use in stage 2
+        // For COUNT(DISTINCT), we count the unique groups
+        // For SUM/AVG/MIN/MAX(DISTINCT), we apply the function to the distinct column
+        let stage2_agg_func = match distinct_agg_func.as_ref().ok_or_else(|| {
+            LimboError::InternalError("Expected aggregate function type".to_string())
+        })? {
+            AggFunc::Count | AggFunc::Count0 => AggregateFunction::Count,
+            AggFunc::Sum => {
+                // The distinct column is the last column in stage1 output
+                let distinct_col_in_stage1 = stage1_group_by.len() - 1;
+                AggregateFunction::Sum(distinct_col_in_stage1)
+            }
+            AggFunc::Avg => {
+                let distinct_col_in_stage1 = stage1_group_by.len() - 1;
+                AggregateFunction::Avg(distinct_col_in_stage1)
+            }
+            AggFunc::Min => {
+                let distinct_col_in_stage1 = stage1_group_by.len() - 1;
+                AggregateFunction::Min(distinct_col_in_stage1)
+            }
+            AggFunc::Max => {
+                let distinct_col_in_stage1 = stage1_group_by.len() - 1;
+                AggregateFunction::Max(distinct_col_in_stage1)
+            }
+            _ => {
+                return Err(LimboError::ParseError(format!(
+                    "Unsupported DISTINCT aggregate function: {distinct_agg_func:?}"
+                )))
+            }
+        };
+
+        let stage2_executable: Box<dyn IncrementalOperator> = Box::new(AggregateOperator::new(
+            stage2_operator_id,
+            stage2_group_indices.clone(),
+            vec![stage2_agg_func.clone()],
+            stage2_column_names,
+        ));
+
+        // Convert indices to DbspExpr for stage2
+        let stage2_group_exprs: Vec<DbspExpr> = stage2_group_indices
+            .iter()
+            .map(|&idx| DbspExpr::Column(stage1_schema.columns[idx].name.clone()))
+            .collect();
+
+        // Output schema matches the original aggregate's schema
+        let stage2_id = self.circuit.add_node(
+            DbspOperator::Aggregate {
+                group_exprs: stage2_group_exprs,
+                aggr_exprs: vec![stage2_agg_func],
+                schema: agg.schema.clone(),
+            },
+            vec![stage1_id],
+            stage2_executable,
+        );
+
+        Ok(stage2_id)
+    }
+
