+do_execsql_test_on_specific_db {:memory:} matview-count-distinct-single-row-groups {
+    CREATE TABLE singles(k TEXT PRIMARY KEY, v INTEGER);
+    INSERT INTO singles VALUES
+        ('a', 1),
+        ('b', 2),
