+
+    CREATE MATERIALIZED VIEW v AS
+        SELECT k, COUNT(DISTINCT v) as cnt FROM singles GROUP BY k;
+
+    SELECT * FROM v ORDER BY k;
+
+    -- Each group has exactly one row, so COUNT(DISTINCT v) = 1
