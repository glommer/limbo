+// Helper function to handle suspension cases (Interrupt, Busy)
+#[inline]
+fn handle_subprogram_suspension(
+    state: &mut ProgramState,
+    mut frame: VdbeFrame,
+    saved_parent_registers: Vec<Register>,
+    saved_parent_pc: u32,
+    result: InsnFunctionStepResult,
+) -> Result<InsnFunctionStepResult> {
+    // Save frame state and restore parent state
+    frame.registers = std::mem::replace(&mut state.registers, saved_parent_registers);
+    frame.pc = state.pc as usize;
+    state.pc = saved_parent_pc;
+
+    // Update the frame on the stack with current state
+    if let Some(stack_frame) = state.frame_stack.last_mut() {
+        stack_frame.pc = frame.pc;
+        stack_frame.registers = frame.registers;
+    }
+    
+    Ok(result)
+}
+
+// Helper to resume execution after I/O
+fn resume_subprogram_execution(
+    program: &Program,
+    state: &mut ProgramState,
+    pager: &Rc<Pager>,
+    mv_store: Option<&Arc<MvStore>>,
+) -> Result<InsnFunctionStepResult> {
+    // Pop the frame and continue execution
+    let frame = state.frame_stack.pop().unwrap();
+    let saved_parent_pc = frame.parent_saved_pc;
+    
+    // The registers are already in state, just need saved parent info
+    execute_subprogram_loop(program, state, pager, mv_store, frame, Vec::new(), saved_parent_pc)
+}