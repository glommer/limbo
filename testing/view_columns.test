#!/usr/bin/env python3
# Tests for view column extraction with various SELECT patterns

# Test: View with specific columns from single table
statement ok
CREATE TABLE customers (id INTEGER PRIMARY KEY, name TEXT, email TEXT);

statement ok
CREATE TABLE orders (id INTEGER PRIMARY KEY, customer_id INTEGER, total REAL, status TEXT);

# Test 1: Simple SELECT with specific columns
statement ok
CREATE VIEW v1 AS SELECT name, email FROM customers;

query TT
PRAGMA table_info(v1);
----
0 name TEXT 0 NULL 0
1 email TEXT 0 NULL 0

# Test 2: JOIN with specific columns from both tables
statement ok
CREATE VIEW v2 AS SELECT c.name, o.total FROM customers c JOIN orders o ON c.id = o.customer_id;

query TT
PRAGMA table_info(v2);
----
0 name TEXT 0 NULL 0
1 total REAL 0 NULL 0

# Test 3: SELECT * from single table
statement ok
CREATE VIEW v3 AS SELECT * FROM customers;

query TT
PRAGMA table_info(v3);
----
0 id INTEGER 0 NULL 0
1 name TEXT 0 NULL 0
2 email TEXT 0 NULL 0

# Test 4: SELECT * with JOIN - should include all columns with duplicate handling
statement ok
CREATE VIEW v4 AS SELECT * FROM customers c JOIN orders o ON c.id = o.customer_id;

query TT
PRAGMA table_info(v4);
----
0 id INTEGER 0 NULL 0
1 name TEXT 0 NULL 0
2 email TEXT 0 NULL 0
3 id:1 INTEGER 0 NULL 0
4 customer_id INTEGER 0 NULL 0
5 total REAL 0 NULL 0
6 status TEXT 0 NULL 0

# Test 5: Mix of specific columns and expressions
statement ok
CREATE VIEW v5 AS SELECT name, id + 1 as next_id, 'customer' as type FROM customers;

query TT
PRAGMA table_info(v5);
----
0 name TEXT 0 NULL 0
1 next_id TEXT 0 NULL 0
2 type TEXT 0 NULL 0

# Test 6: Table.* with specific columns
statement ok
CREATE VIEW v6 AS SELECT c.*, o.total FROM customers c JOIN orders o ON c.id = o.customer_id;

query TT
PRAGMA table_info(v6);
----
0 id INTEGER 0 NULL 0
1 name TEXT 0 NULL 0
2 email TEXT 0 NULL 0
3 total REAL 0 NULL 0

# Test 7: View with column aliases
statement ok
CREATE VIEW v7 AS SELECT c.name AS customer_name, o.total AS order_amount
FROM customers c JOIN orders o ON c.id = o.customer_id;

query TT
PRAGMA table_info(v7);
----
0 customer_name TEXT 0 NULL 0
1 order_amount REAL 0 NULL 0

# Test 8: View with qualified column names (no alias)
statement ok
CREATE VIEW v8 AS SELECT customers.name, orders.total
FROM customers JOIN orders ON customers.id = orders.customer_id;

query TT
PRAGMA table_info(v8);
----
0 name TEXT 0 NULL 0
1 total REAL 0 NULL 0